{
  // Spell Car server on Cloudflare Workers. KV and R2 are created automatically on first deploy.
  "name": "spellcar",
  "main": "src/index.js",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "kv_namespaces": [{ "binding": "STATE" }],
  "r2_buckets": [{ "binding": "CLIPS" }],
  "triggers": { "crons": ["* * * * *"] },
  "vars": {
    "KID_NAME": "Luna",
    "AZURE_OPENAI_API_VERSION": "2024-10-21",
    "AZURE_OPENAI_IMAGE_API_VERSION": "2024-10-21",
    "VEO_MODEL": "veo-3.1-fast-generate-preview",
    "STORIES_PER_DAY": "40", "IMAGES_PER_DAY": "20", "TTS_CHARS_PER_DAY": "60000", "VIDEOS_PER_DAY": "16"
  },
  "observability": { "enabled": true }
}
