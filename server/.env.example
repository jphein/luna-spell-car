# Copy to server/.env and fill in. Never commit the real .env.
SPELLCAR_TOKEN=change-me-to-a-long-random-string
AZURE_OPENAI_ENDPOINT=https://YOUR-RESOURCE.openai.azure.com
AZURE_OPENAI_KEY=
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-4o-mini
AZURE_OPENAI_API_VERSION=2024-10-21
# Optional: AI pictures (dall-e-3 works with 2024-10-21; gpt-image-1 needs 2025-04-01-preview)
AZURE_OPENAI_IMAGE_DEPLOYMENT=
AZURE_OPENAI_IMAGE_API_VERSION=2024-10-21
# Optional: neural voices (Azure AI Speech resource)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westus2
# Optional: "Make it move" animations with Google Veo (Gemini API key from aistudio.google.com)
GEMINI_API_KEY=
VEO_MODEL=veo-3.1-lite-generate-preview
VIDEOS_PER_DAY=16
KID_NAME=Luna
STORIES_PER_DAY=40
IMAGES_PER_DAY=20
TTS_CHARS_PER_DAY=60000
PORT=8787
